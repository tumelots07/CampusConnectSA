
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUSCONNECT SA"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Campus Safety"
            android:textColor="?attr/colorOnSurface"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Your safety matters. Find help, stay informed and report incidents."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"/>

        <!-- Emergency banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_dashboard_banner">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEED URGENT HELP?"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your safety comes first."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Use the emergency contacts below if you need immediate assistance."
                android:textColor="#E0F2FE"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnEmergencyCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Call emergency services — 112"
                android:textColor="#FFFFFF"
                android:backgroundTint="#DC2626"/>
        </LinearLayout>

        <!-- Emergency contacts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Emergency contacts"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_service_card"
            android:backgroundTint="?attr/colorSurface"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Police emergency"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="10111"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnPoliceCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Call police"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorOutlineVariant"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ambulance"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="10177"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnAmbulanceCall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Call ambulance"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary"/>
        </LinearLayout>

        <!-- Safety reminders -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Safety reminders"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_service_card"
            android:backgroundTint="?attr/colorSurface"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Stay in well-lit areas when walking at night."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:paddingBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Keep your valuables secure and out of sight."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:paddingBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Let someone you trust know when travelling."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:paddingBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Report suspicious activity to campus security."
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Incident report -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Report a safety incident"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Provide details about an incident that needs attention."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_service_card"
            android:backgroundTint="?attr/colorSurface"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incident type"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <Spinner
                android:id="@+id/spIncidentType"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dashboard_card"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Location"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etIncidentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dashboard_card"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:hint="Where did it happen?"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:padding="12dp"
                android:inputType="textCapSentences"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Incident description"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etIncidentDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_dashboard_card"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:gravity="top"
                android:hint="Describe what happened..."
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:padding="12dp"
                android:inputType="textMultiLine|textCapSentences"/>

            <Button
                android:id="@+id/btnSubmitIncident"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Submit incident report"
                android:textColor="?attr/colorOnPrimary"
                android:backgroundTint="?attr/colorPrimary"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="For immediate danger, contact emergency services directly. Do not rely on this demonstration form."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"/>

    </LinearLayout>
</ScrollView>
